{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omit",
  "version": "2.0.0",
  "identifier": "app.omit.shield",
  "build": {
    "frontendDist": "../../app/src/main/assets/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Omit",
        "width": 440,
        "height": 780,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    }
  }
}
