<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111512"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_qs_shield" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omit · Protected"
            android:textColor="#EDF2EE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 blocked"
            android:textColor="#7FD4AE"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="#1A1F1C"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="60s Pause"
        android:textAllCaps="false"
        android:textColor="#7FD4AE"
        android:textSize="12sp" />
</LinearLayout>
