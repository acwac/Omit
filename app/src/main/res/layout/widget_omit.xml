<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_omit_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_omit_pill"
        android:padding="6dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_qs_shield" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omit · Protected"
            android:textColor="#EDF2EE"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 blocked"
            android:textColor="#7FD4AE"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_omit_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="60s Pause"
        android:textColor="#7FD4AE"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
